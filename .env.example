# ===== 数据库连接配置 =====
# SQL Server (金蝶数据库)
DB_SERVER=192.168.0.234
DB_DATABASE=AIS20191210135722
DB_USERNAME=sa
DB_PASSWORD=your_password_here

# 可选的第二个数据库 schema (2023 数据库)
# DB_SCHEMA_2023=AIS20230525154804.dbo

# ===== MySQL 配置（用于 write_mysql.py）=====
MYSQL_USER=su
MYSQL_PASSWORD=123456
MYSQL_HOST=192.168.0.118
MYSQL_DATABASE=material_table

# ===== Flask 配置 =====
# SECRET_KEY 若不设置则自动随机生成
# SECRET_KEY=your_secret_key_here

# ===== 开发模式 =====
# DEV_MODE=True   # 设置为 True 可跳过真实数据库连接（仅开发调试用）

# ===== PDF 翻译（视觉大模型）=====
# provider: qwen（默认，国内直连）/ gemini / openai / glm
VISION_PROVIDER=qwen
DASHSCOPE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ZHIPU_API_KEY=
# 自定义 OpenAI 兼容端点
# VISION_BASE_URL=
# VISION_MODEL=
# VISION_PROXY=http://127.0.0.1:7897
